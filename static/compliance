  <title>SLP CONNECT™ Healthcare Compliance</title>
  <style>
    :root {
      --ink:#102033; --muted:#5f7187; --blue:#1f5fbf; --navy:#0b2f57;
      --teal:#0f9f9a; --gold:#f5b942; --light:#f6f9fc; --line:#dce6ef;
      --card:#ffffff; --shadow: 0 24px 70px rgba(16,32,51,.12);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin:0; font-family: Arial, Helvetica, sans-serif; color:var(--ink); background:white; line-height:1.6; }
    a { color:inherit; text-decoration:none; }
    .wrap { width:min(1120px, calc(100% - 40px)); margin:0 auto; }
    .eyebrow { color:var(--teal); font-weight:700; letter-spacing:.08em; text-transform:uppercase; font-size:.82rem; }
    h1, h2, h3 { line-height:1.12; margin:0 0 18px; }
    h1 { font-size:clamp(2.5rem, 6vw, 5.7rem); letter-spacing:-.06em; max-width:930px; }
    h2 { font-size:clamp(2rem, 4vw, 3.35rem); letter-spacing:-.04em; }
    h3 { font-size:1.25rem; }
    p { margin:0 0 18px; color:var(--muted); font-size:1.05rem; }
    .btns { display:flex; gap:14px; flex-wrap:wrap; margin-top:28px; }
    .btn { display:inline-flex; align-items:center; justify-content:center; padding:14px 22px; border-radius:999px; font-weight:700; border:1px solid transparent; }
    .btn.primary { background:var(--blue); color:white; box-shadow:0 12px 30px rgba(31,95,191,.28); }
    .btn.secondary { border-color:rgba(255,255,255,.4); color:white; }
    .btn.light { border-color:var(--line); background:white; color:var(--navy); }
    .hero { position:relative; overflow:hidden; padding:28px 0 92px; color:white; background:radial-gradient(circle at 80% 20%, rgba(15,159,154,.45), transparent 34%), linear-gradient(135deg, #071f3d 0%, #0b2f57 58%, #164a86 100%); }
    .nav { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:10px 0 70px; }
    .brand { font-weight:800; letter-spacing:-.03em; font-size:1.35rem; }
    .navlinks { display:flex; gap:24px; color:rgba(255,255,255,.78); font-weight:600; font-size:.95rem; }
    .hero p { color:rgba(255,255,255,.82); font-size:1.22rem; max-width:760px; }
    .hero-card { margin-top:46px; display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.18); border-radius:24px; overflow:hidden; backdrop-filter: blur(14px); }
    .metric { padding:24px; background:rgba(255,255,255,.08); }
    .metric strong { display:block; font-size:1.05rem; margin-bottom:6px; color:white; }
    .metric span { color:rgba(255,255,255,.7); font-size:.92rem; }
    section { padding:84px 0; }
    .split { display:grid; grid-template-columns: .95fr 1.05fr; gap:54px; align-items:center; }
    .panel { background:var(--light); border:1px solid var(--line); border-radius:28px; padding:34px; }
    .quote { border-left:5px solid var(--teal); padding-left:24px; font-size:1.35rem; line-height:1.35; color:var(--navy); font-weight:700; }
    .grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
    .card { background:var(--card); border:1px solid var(--line); border-radius:24px; padding:28px; box-shadow:0 12px 32px rgba(16,32,51,.06); }
    .icon { width:42px; height:42px; border-radius:14px; background:rgba(15,159,154,.12); color:var(--teal); display:grid; place-items:center; font-weight:900; margin-bottom:18px; }
    .dark { background:var(--navy); color:white; }
    .dark p { color:rgba(255,255,255,.75); }
    .use-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-top:30px; }
    .use { padding:24px; border-radius:22px; border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.07); }
    .checklist { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; margin-top:28px; }
    .check { display:flex; gap:12px; padding:18px; border-radius:18px; background:white; border:1px solid var(--line); color:var(--ink); }
    .check b { color:var(--teal); }
    .cta { background:linear-gradient(135deg, #f6f9fc, #eaf4ff); text-align:center; }
    .cta p { max-width:720px; margin-left:auto; margin-right:auto; }
    .footer-note { margin-top:24px; font-size:.88rem; color:var(--muted); }
    @media (max-width: 860px) { .navlinks { display:none; } .hero-card, .grid, .split, .use-grid, .checklist { grid-template-columns:1fr; } section { padding:62px 0; } }
