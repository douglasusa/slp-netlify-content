</head>
<body>
  <main>
    <section class="hero" id="hero">
      <div class="wrap">
        <nav class="nav" aria-label="Page navigation">
          <div class="brand">SLP CONNECT™</div>
          <div class="navlinks">
            <a href="#solution">Platform</a>
